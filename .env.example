# ============================================================
# Скопируй в .env и заполни своими значениями
# НИКОГДА не коммить .env в git!
# ============================================================

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# --- HH.ru аккаунт ---
# Email и пароль от вашего аккаунта соискателя на hh.ru
HH_USERNAME=your@email.com
HH_PASSWORD=your_hh_password

# ID резюме для отклика (можно получить из URL резюме на hh.ru)
# Например: https://hh.ru/resume/abc123def456 → HH_RESUME_ID=abc123def456
HH_RESUME_ID=abc123def456

# --- Сопроводительное письмо ---
# Поддерживаются переменные: {title}, {employer}
COVER_LETTER=Добрый день!\n\nМеня заинтересовала вакансия «{title}» в компании {employer}.\n\nЯ — Python-разработчик с опытом 5+ лет в backend-разработке (FastAPI, Django, asyncio, PostgreSQL, Docker, K8s). Участвовал в проектах с нагрузкой 10k RPS, выстраивал CI/CD пайплайны, проводил ревью.\n\nГотов обсудить детали в удобное для вас время.\n\nС уважением,\nИмя Фамилия

# --- Путь к конфигу (опционально) ---
CONFIG_PATH=config.yaml
